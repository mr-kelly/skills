# busabase-community — copy to .env (gitignored) and fill in.
#   cp .env.example .env && chmod 600 .env
#
# Files are read nearest-first: $BUSABASE_ENV_FILE, this directory's
# .env.local then .env, ~/.config/busabase-community/.env, ~/.busabase/.env.
# A variable already exported in the shell always wins over every file.

# Required — reads and posts. https://busabase.com/docs/api-tokens
BUSABASE_API_KEY=

# Optional — unlocks `admin`, the moderation surface. This is the deployment's
# own SYSTEM_ADMIN_API_SECRET_KEY, not a per-user token: it can hide, move and
# permanently delete anyone's content. Leave empty unless you operate the forum.
# A bare SYSTEMADMIN_KEY works too, and covers several forums at once.
BUSABASE_SYSTEMADMIN_KEY=

# Optional — override only for a self-hosted deployment.
# BUSABASE_COMMUNITY_API_URL=https://busabase.com
# BUSABASE_COMMUNITY_URL=https://community.busabase.com
