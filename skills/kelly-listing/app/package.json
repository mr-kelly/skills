{
  "name": "kelly-listing-airapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build:sdk": "esbuild node_modules/busabase-sdk/dist/index.js --bundle --format=esm --platform=browser --outfile=app/vendor/busabase-sdk.js && esbuild node_modules/busabase-sdk/dist/oauth.js --bundle --format=esm --platform=browser --outfile=app/vendor/busabase-oauth.js && esbuild node_modules/busabase-sdk/dist/oauth-node.js --bundle --format=esm --platform=node --outfile=app/vendor/busabase-oauth-node.js",
    "check": "node scripts/check.mjs && node --test",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@hono/node-server": "2.0.8",
    "busabase-sdk": "0.11.0",
    "hono": "4.12.29"
  },
  "devDependencies": {
    "esbuild-wasm": "0.28.1"
  }
}
