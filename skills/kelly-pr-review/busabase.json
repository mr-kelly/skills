{
  "format": "busabase-package@1",
  "name": "kelly-pr-review",
  "description": "GitHub pull request review desk backed by the gh CLI",
  "version": "0.1.0",
  "license": "MIT",
  "tags": ["platform", "risk:gated-write", "surface:busabase", "surface:github"],
  "template": {
    "category": "platform",
