    "airapp": "kelly-pr-review-app",
    "tags": ["platform", "risk:gated-write", "surface:busabase", "surface:github"],
    "screenshots": [
      "assets/screenshots/blocked-security.webp",
      "assets/screenshots/needs-review.webp",
