{
  "name": "kelly-email-airapp",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build:sdk": "esbuild scripts/sdk-entry.js --bundle --format=esm --platform=browser --minify-whitespace --banner:js=\"// @ts-nocheck\" --outfile=app/vendor/busabase-sdk.js && node scripts/normalize-bundle.mjs",
    "check": "node scripts/check.mjs && node --test",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@hono/node-server": "2.0.8",
    "busabase-sdk": "0.99.1",
    "hono": "4.12.29"
  },
  "devDependencies": {
    "esbuild-wasm": "0.28.1"
  }
}
