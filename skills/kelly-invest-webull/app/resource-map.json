{
  "schemaVersion": 1,
  "runtimeSpace": "ambient-or-local-selection",
  "provisioning": {
    "mode": "lazy",
    "trigger": "after-space-selection-or-explicit-setup-action",
    "mutations": ["nodes.createChangeRequest", "nodes.updateMetadata"],
    "legacyRepair": "exact-resource-fingerprint-only",
    "autoMergeApprovedStructure": true,
    "schemaSource": "app/js/config.js"
  },
  "appRoot": {
    "kind": "folder",
    "slug": "kelly-invest-webull"
  },
  "resources": [
    {
      "key": "accounts",
      "kind": "base",
      "slug": "kelly-invest-webull-accounts-v1",
      "schemaVersion": 1,
      "readLimit": 20
    },
    {
      "key": "positions",
      "kind": "base",
      "slug": "kelly-invest-webull-positions-v1",
      "schemaVersion": 1,
      "readLimit": 100
    },
    {
      "key": "settings",
      "kind": "base",
      "slug": "kelly-invest-webull-settings-v1",
      "schemaVersion": 1,
      "readLimit": 20
    }
  ],
  "vaultRequirements": [],
  "trustedExecution": {
    "portfolioSync": "scripts/sync_webull.mjs (trusted skill-root script, own Busabase credentials, autoMerge on standalone local runtime)"
  }
}
